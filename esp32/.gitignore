# ── ESP-IDF build output ──────────────────────────────────────────────────────
# Hundreds of MB; fully regenerated by idf.py build
build/

# Stale config backup written on every menuconfig run
sdkconfig.old

# Component manager downloads — reinstalled from idf_component.yml + dependencies.lock
# (analogous to node_modules; the lock file is committed, not this directory)
managed_components/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.pytest_cache/
pytest_build/
.pytest_tmp*/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.Spotlight-V100
.Trashes

# ── Editor / tool caches ──────────────────────────────────────────────────────
*.swp
*.swo
*~
.cache/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
idf_monitor*.log
